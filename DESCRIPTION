Package: gpmapr
Title: Query the 'OpenGWAS' Genotype-Phenotype Map
Version: 1.0.0
Authors@R: c(
    person("Andrew", "Elmore", , "andrew.elmore@bristol.ac.uk", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-0292-447X")),
    person("Gibran", "Hemani", , "g.hemani@bristol.ac.uk", role = "aut",
           comment = c(ORCID = "0000-0003-0920-1055"))
